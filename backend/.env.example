# ========================================================
# Enterprise RAG Backend Environment Variables
# ========================================================

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Database (Leave default for SQLite file, or provide PostgreSQL URI)
# DATABASE_URL=sqlite:///chat_history.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Origins (Comma-separated list of allowed origins)
# Vercel apps (*.vercel.app) are automatically permitted
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================================
# LLM Provider Configuration
# ========================================================

# Option 1: Groq Cloud (Recommended for Cloud Hosting - 100% Free & Blazing Fast)
# Sign up at https://console.groq.com and generate a free API key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (Alternative Free Cloud Option)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Option 3: Local Ollama (Used when no API keys are provided)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
